{
  "name": "ai-img-gen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check:handoff && npm run check:boundaries && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "test:contracts": "vitest run tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run --config vitest.acceptance.config.mts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/worker/main.ts",
    "test:e2e:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "check:handoff": "node scripts/check-handoff.mjs"
  },
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.4",
    "konva": "10.9.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
